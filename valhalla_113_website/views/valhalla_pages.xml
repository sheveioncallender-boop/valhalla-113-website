<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <template id="about_page" name="About Valhalla">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure v113-page">
                    <section class="v113-inner-hero" style="background-image:linear-gradient(90deg,rgba(0,0,0,.93),rgba(0,0,0,.40)),url('/valhalla_113_website/static/src/img/hero_sports_bar.jpg')">
                        <div class="v113-container">
                            <span class="v113-red-label">Our story</span>
                            <h1>Welcome to Valhalla 113.</h1>
                            <p>A place for big games, bold flavours, and good company in Caroni.</p>
                        </div>
                    </section>
                    <section class="v113-section">
                        <div class="v113-container v113-split">
                            <div>
                                <span class="v113-red-label">Sports. Food. Legends.</span>
                                <h2>Your spot for the next great night.</h2>
                                <p>Valhalla 113 Bar &amp; Grill brings together the things that make a great lime: food from the grill, cold drinks, live sports, and your favourite people.</p>
                                <p>Join us at 113 Frederick Settlement, Old Southern Main Road, Caroni. Whether you are catching a game or getting together with friends, there is a place for you here.</p>
                                <a href="/visit-us" class="v113-btn v113-btn-primary">Plan Your Visit</a>
                            </div>
                            <img src="/valhalla_113_website/static/src/img/hero_sports_bar.jpg" alt="Valhalla sports bar atmosphere" loading="lazy"/>
                        </div>
                    </section>
                    <section class="v113-section v113-cta">
                        <div class="v113-container">
                            <span class="v113-red-label">Make it a Valhalla day</span>
                            <h2>Good food. Great company.</h2>
                            <div class="v113-actions">
                                <a href="/shop" class="v113-btn v113-btn-primary">Explore the Menu</a>
                                <a href="/visit-us" class="v113-btn v113-btn-outline">Find Us in Caroni</a>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>
        <record id="page_about" model="website.page">
            <field name="name">About Valhalla</field>
            <field name="url">/about-valhalla</field>
            <field name="view_id" ref="about_page"/>
            <field name="is_published" eval="True"/>
            <field name="website_meta_description">About Valhalla at Valhalla 113 Bar &amp; Grill in Caroni, Trinidad and Tobago.</field>
        </record>
        <template id="whats_on_page" name="What's On">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure v113-page">
                    <section class="v113-inner-hero" style="background-image:linear-gradient(90deg,rgba(0,0,0,.93),rgba(0,0,0,.40)),url('/valhalla_113_website/static/src/img/event_soca.jpg')">
                        <div class="v113-container">
                            <span class="v113-red-label">Get together</span>
                            <h1>There is always a reason to lime.</h1>
                            <p>Live sports, music, karaoke, and celebrations. Contact our team for the latest dates and details.</p>
                        </div>
                    </section>
                    <section class="v113-section">
                        <div class="v113-container v113-content-grid">
                            <article class="v113-story-card">
                                <img src="/valhalla_113_website/static/src/img/event_ufc.jpg" alt="Live Sports" loading="lazy"/>
                                <div>
                                    <h2>Live Sports</h2>
                                    <p>Share the big moments on the big screen. Contact us for the next match or fight screening.</p>
                                </div>
                            </article>
                            <article class="v113-story-card">
                                <img src="/valhalla_113_website/static/src/img/event_karaoke.jpg" alt="Karaoke Nights" loading="lazy"/>
                                <div>
                                    <h2>Karaoke Nights</h2>
                                    <p>Pick your song and bring your crew. Ask the team about the next karaoke night.</p>
                                </div>
                            </article>
                            <article class="v113-story-card">
                                <img src="/valhalla_113_website/static/src/img/event_soca.jpg" alt="Music &amp; Good Vibes" loading="lazy"/>
                                <div>
                                    <h2>Music &amp; Good Vibes</h2>
                                    <p>Soca, friends, and an atmosphere made for a good lime. Find out what is coming up.</p>
                                </div>
                            </article>
                            <article class="v113-story-card">
                                <img src="/valhalla_113_website/static/src/img/event_reggae.jpg" alt="A Night to Remember" loading="lazy"/>
                                <div>
                                    <h2>A Night to Remember</h2>
                                    <p>Make time for music and good company. Contact us for current nights and specials.</p>
                                </div>
                            </article>
                        </div>
                    </section>
                    <section class="v113-section v113-cta">
                        <div class="v113-container v113-split">
                            <div>
                                <span class="v113-red-label">Bring your people</span>
                                <h2>Private events &amp; celebrations.</h2>
                                <p>Planning a birthday, team lime, or special occasion? Tell us your preferred date and group size so our team can discuss availability.</p>
                                <p>Your booking is confirmed when our team confirms the arrangements with you.</p>
                            </div>
                            <div class="v113-actions">
                                <a class="v113-btn v113-btn-primary" href="tel:+18683090421">Call to Enquire</a>
                                <a class="v113-btn v113-btn-outline" href="/contactus">Send an Enquiry</a>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>
        <record id="page_whats_on" model="website.page">
            <field name="name">What's On</field>
            <field name="url">/whats-on</field>
            <field name="view_id" ref="whats_on_page"/>
            <field name="is_published" eval="True"/>
            <field name="website_meta_description">What's On at Valhalla 113 Bar &amp; Grill in Caroni, Trinidad and Tobago.</field>
        </record>
        <template id="gallery_page" name="Gallery">
