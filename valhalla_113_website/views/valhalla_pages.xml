                <div id="wrap" class="oe_structure v113-page">
                    <section class="v113-inner-hero" style="background-image:linear-gradient(90deg,rgba(0,0,0,.93),rgba(0,0,0,.40)),url('/valhalla_113_website/static/src/img/hero_sports_bar.jpg')">
                        <div class="v113-container">
                            <span class="v113-red-label">The Valhalla experience</span>
                            <h1>Get a taste of the atmosphere.</h1>
                            <p>Food, drinks, sports, and nights spent together.</p>
                        </div>
                    </section>
                    <section class="v113-section">
                        <div class="v113-container v113-photo-grid">
