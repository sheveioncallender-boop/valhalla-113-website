        <template id="about_page" name="About Valhalla">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure v113-page">
                    <section class="v113-inner-hero">
                        <div class="v113-container v113-inner-grid">
                            <div>
                                <span class="v113-eyebrow">A Caroni kind of welcome</span>
                                <h1>COME FOR A BITE.<br/>
                                    <em>STAY FOR THE LIME.</em>
                                </h1>
                                <p>Valhalla 113 brings food, drinks, and island sounds together in one place.</p>
                            </div>
                            <img src="/valhalla_113_website/static/src/img/social-lime.jpg" alt="Food and drinks inspiration" class="v113-inner-photo" loading="eager" fetchpriority="high"/>
                        </div>
                    </section>
                    <section class="v113-section v113-light">
                        <div class="v113-container v113-split">
                            <img src="/valhalla_113_website/static/src/img/grill-editorial.jpg" alt="Grilled chicken served with herbs" class="v113-story-photo" loading="lazy"/>
                            <div>
                                <span class="v113-eyebrow">Bar. Grill. Gathering place.</span>
                                <h2>Good company<br/>belongs here.</h2>
                                <p>Some plans start with a meal. Others start with “where we liming?” At Valhalla 113, there’s room for both.</p>
                                <p>Find us in Frederick Settlement, Caroni, for food, cold drinks, and a music-filled night with your people. From an after-work catch-up to a live performance, it’s the company that makes it.</p>
                                <div class="v113-actions">
                                    <a href="/shop" class="btn btn-primary v113-button">Explore the menu<span class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="v113-section v113-dark">
                        <div class="v113-container v113-section-head">
                            <div>
                                <span class="v113-eyebrow">Rooted in island culture</span>
                                <h2>Our kind<br/>of energy.</h2>
                            </div>
                            <div>
                                <p>Soca. Reggae. Dancehall. DJs and live performers. Follow our social pages for the nights, artists, and specials coming to Valhalla.</p>
                                <div class="v113-actions">
                                    <a href="/whats-on" class="btn btn-primary v113-button">What’s on<span class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                    <a href="https://www.instagram.com/valhalla113tt/" class="btn btn-outline-light v113-button">Follow Instagram<span class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="v113-visit-band">
                        <div class="v113-container v113-band-grid">
                            <div>
                                <span class="v113-eyebrow">113 Frederick Settlement · Caroni</span>
                                <h2>Same place.<br/>Your next great lime.</h2>
                            </div>
                            <div>
                                <p>Bring your people. We’ll see you at Valhalla.</p>
                                <div class="v113-actions">
                                    <a href="/visit-us" class="btn btn-primary v113-button">Find us in Caroni<span class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                    <a href="/contactus" class="btn btn-outline-light v113-button">Get in touch<span class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>
        <record id="page_about" model="website.page">
