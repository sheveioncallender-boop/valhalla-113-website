        <template id="ordering_page" name="How to Order">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure v113-page">
                    <section class="v113-inner-hero">
                        <div class="v113-container v113-inner-grid">
                            <div>
                                <span class="v113-eyebrow">From our menu to your moment</span>
                                <h1>LET’S GET<br/>
                                    <em>YOUR ORDER STARTED.</em>
                                </h1>
                                <p>Ordering online or already at your table? Here’s how to get going.</p>
                            </div>
                            <img src="/valhalla_113_website/static/src/img/grill-editorial.jpg" alt="Food and drinks inspiration" class="v113-inner-photo" loading="eager" fetchpriority="high"/>
                        </div>
                    </section>
                    <section class="v113-section v113-light">
                        <div class="v113-container v113-content-grid">
                            <article class="v113-info-card">
                                <span class="v113-eyebrow">01 · Order online</span>
                                <h2>Browse. Choose.<br/>Check out.</h2>
                                <ol class="v113-steps">
                                    <li>Open the menu and choose your items and options.</li>
                                    <li>Add them to your cart and check your order.</li>
                                    <li>Continue to checkout for the available fulfilment and payment options.</li>
                                </ol>
                                <div class="v113-actions">
                                    <a href="/shop" class="btn btn-primary v113-button">Browse &amp; order<span class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                </div>
                                <a class="v113-text-link" href="/my/orders">View my online orders ↗</a>
                            </article>
                            <article class="v113-info-card">
                                <span class="v113-eyebrow">02 · At your table</span>
                                <h2>Scan. Choose.<br/>Enjoy the lime.</h2>
                                <ol class="v113-steps">
                                    <li>Scan the QR code at your own table.</li>
                                    <li>Choose your food and drinks from the table menu.</li>
                                    <li>Follow the on-screen instructions to place your order.</li>
                                </ol>
                                <p>Need a hand? Ask a team member. Your table code connects the order to where you’re sitting.</p>
                            </article>
                        </div>
                    </section>
                    <section class="v113-section v113-dark">
                        <div class="v113-container v113-section-head">
                            <div>
                                <span class="v113-eyebrow">We’re here to help</span>
                                <h2>A question<br/>with your order?</h2>
                            </div>
                            <div>
                                <p>For ingredient questions, special requests, or help with an order, contact the team before placing it.</p>
                                <div class="v113-actions">
                                    <a href="tel:+18683090421" class="btn btn-primary v113-button">Call (868) 309-0421<span class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                    <a href="/contactus" class="btn btn-outline-light v113-button">Contact us<span class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
