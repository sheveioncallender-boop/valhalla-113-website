<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="valhalla_landing_content" name="Valhalla 113 Landing Content">
        <div id="wrap" class="v113-page oe_structure">
            <section class="v113-hero" id="home">
                <div class="v113-container v113-hero-grid">
                    <div class="v113-hero-copy">
                        <div class="v113-kicker">This is Valhalla 113</div>
                        <h1>Sports. <span>Food.</span>
                            <br/>Legends.</h1>
                        <p>Your ultimate destination for live sports, great food, ice-cold drinks, private events, and unforgettable nights in Caroni.</p>
                        <div class="v113-actions">
                            <a class="v113-btn v113-btn-primary" href="/shop">Order Online <span class="fa fa-cutlery"/>
                            </a>
                            <a class="v113-btn v113-btn-outline" href="/visit-us">Plan Your Visit <span class="fa fa-calendar"/>
                            </a>
                        </div>
                    </div>
                </div>
            </section>
            <section class="v113-features" id="about">
                <div class="v113-container v113-feature-grid">
                    <div class="v113-feature-card">
                        <span class="v113-feature-icon fa fa-futbol-o"/>
                        <div>
                            <h3>Live Sports</h3>
                            <p>Catch the biggest games on our big screens.</p>
                        </div>
                    </div>
                    <div class="v113-feature-card">
                        <span class="v113-feature-icon fa fa-bars"/>
                        <div>
                            <h3>Great Food</h3>
                            <p>Delicious grilled meals made fresh to order.</p>
                        </div>
                    </div>
                    <div class="v113-feature-card">
                        <span class="v113-feature-icon fa fa-glass"/>
                        <div>
                            <h3>Cold Drinks</h3>
                            <p>Beers, cocktails, premium spirits, and specials.</p>
                        </div>
                    </div>
                    <div class="v113-feature-card">
                        <span class="v113-feature-icon fa fa-users"/>
                        <div>
                            <h3>Good Vibes</h3>
                            <p>Great music, great people, and a lively atmosphere.</p>
                        </div>
                    </div>
                </div>
            </section>
            <section class="v113-section v113-menu-section" id="menu">
                <div class="v113-container">
                    <div class="v113-section-title">
                        <span>Our Menu</span>
                        <h2>Menu Highlights</h2>
                        <p>Find your next favourite. Explore our menu and order online.</p>
                    </div>
                    <div class="v113-live-menu o_not_editable">
                        <t t-set="menu_products" t-value="website._valhalla_menu_products()"/>
                        <t t-set="menu_prices" t-value="menu_products._get_sales_prices(website)"/>
                        <div class="v113-menu-grid" t-if="menu_products">
                            <article class="v113-menu-card" t-foreach="menu_products" t-as="product">
                                <a t-att-href="product.website_url" class="v113-product-link">
                                    <img t-att-src="website.image_url(product, 'image_512')" t-att-alt="product.name" loading="lazy"/>
                                    <div class="v113-menu-info">
                                        <div>
                                            <h3 t-field="product.name"/>
                                            <p>View item &amp; options <span class="fa fa-angle-right" aria-hidden="true"/>
                                            </p>
                                        </div>
                                        <strong t-if="menu_prices[product.id]['price_reduce'] or not website.prevent_zero_price_sale" t-out="menu_prices[product.id]['price_reduce']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                        <span t-else="">Contact us</span>
                                    </div>
                                </a>
                            </article>
                        </div>
                        <div t-else="" class="v113-empty-menu">
                            <h3>Something good is on the menu.</h3>
                            <p>Call our team for today's food and drinks, or check the online menu for available items.</p>
                            <a class="v113-btn v113-btn-primary" href="tel:+18683090421">Call (868) 309-0421</a>
                        </div>
                    </div>
                    <div class="v113-center">
                        <a class="v113-btn v113-btn-dark" href="/shop">Explore the Full Menu <span class="fa fa-list"/> View Full Menu</a>
                    </div>
                </div>
            </section>
            <section class="v113-section v113-events-section" id="events">
                <div class="v113-container">
                    <div class="v113-section-title v113-section-title-dark">
                        <span>Good Times at Valhalla</span>
                        <h2>What's Happening</h2>
                        <p>Big games, music, and nights worth getting together for.</p>
                    </div>
                    <div class="v113-events-layout">
                        <div class="v113-event-grid">
                            <article class="v113-event-card">
                                <img src="/valhalla_113_website/static/src/img/event_soca.jpg" alt="Soca Fridays" loading="lazy"/>
                                <div>
                                    <h3>
                                        <a href="/whats-on">Soca Fridays</a>
                                    </h3>
                                    <p>Ask us what’s coming up</p>
                                </div>
                            </article>
                            <article class="v113-event-card">
                                <img src="/valhalla_113_website/static/src/img/event_reggae.jpg" alt="Reggae Night" loading="lazy"/>
                                <div>
                                    <h3>
                                        <a href="/whats-on">Reggae Night</a>
                                    </h3>
                                    <p>Ask us what’s coming up</p>
                                </div>
                            </article>
                            <article class="v113-event-card">
                                <img src="/valhalla_113_website/static/src/img/event_karaoke.jpg" alt="Karaoke Sundays" loading="lazy"/>
                                <div>
                                    <h3>
                                        <a href="/whats-on">Karaoke Sundays</a>
                                    </h3>
                                    <p>Ask us what’s coming up</p>
                                </div>
                            </article>
                            <article class="v113-event-card">
                                <img src="/valhalla_113_website/static/src/img/event_ufc.jpg" alt="UFC Fight Nights" loading="lazy"/>
                                <div>
                                    <h3>
                                        <a href="/whats-on">UFC Fight Nights</a>
                                    </h3>
                                    <p>Ask us what’s coming up</p>
                                </div>
                            </article>
                        </div>
                        <aside class="v113-booking-card">
                            <span class="fa fa-calendar-o"/>
                            <h3>Private Events &amp; Bookings</h3>
                            <p>Celebrate birthdays, team limes, fight nights, and special occasions with us.</p>
                            <a class="v113-btn v113-btn-outline" href="/visit-us">Plan Your Visit <span class="fa fa-angle-right"/>
                            </a>
                        </aside>
                    </div>
                </div>
            </section>
            <section class="v113-section v113-gallery" id="gallery">
                <div class="v113-container v113-gallery-grid">
                    <div>
                        <span class="v113-red-label">The Valhalla Experience</span>
                        <h2>Built for big games, good food, and unforgettable nights.</h2>
                        <p>Bring your friends, pick your spot, and make a night of it at Valhalla 113.</p>
                    </div>
                    <div class="v113-stat-grid">
                        <div>
                            <strong>Live</strong>
                            <span>Sports</span>
                        </div>
                        <div>
                            <strong>Grill</strong>
                            <span>Food</span>
                        </div>
                        <div>
                            <strong>Cold</strong>
                            <span>Drinks</span>
                        </div>
                        <div>
                            <strong>Event</strong>
                            <span>Ready</span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </template>
    <template id="valhalla_113_standalone_page" name="Valhalla 113 Website Page">
        <t t-call="website.layout">
            <t t-call="valhalla_113_website.valhalla_landing_content"/>
        </t>
    </template>
    <record id="page_valhalla_113" model="website.page">
        <field name="name">Valhalla 113</field>
        <field name="url">/valhalla-113</field>
        <field name="view_id" ref="valhalla_113_standalone_page"/>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
